<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:GameFlow.App.Views"
             xmlns:vm="using:GameFlow.App.ViewModels"
             x:Class="GameFlow.App.Views.ControllerSurface"
             x:DataType="vm:ControllerVisualStateViewModel"
             x:CompileBindings="True">

    <!--
        Outer Border background is bound to the VM so the user can flip
        the panel between solid (default "#09111B") and "Transparent"
        for the see-through effect described in design point 6.
    -->
    <!--
        Chrome follows the app theme live (DynamicResource); the user's
        background preset paints an overlay layer above it. A null overlay
        (the "Theme default" preset) lets the themed base show through, so
        switching the app theme recolours the panel immediately.
    -->
    <!--
        Classes="panel" carries the chrome (surface, border, 14px corner) so
        it tracks the app theme centrally. Name and the pressed handler stay:
        ControllerSurface.axaml.cs looks PanelRoot up by name to set the hand
        cursor, and routes the click through to the view model's RequestEdit.
    -->
    <Border Classes="panel"
            Name="PanelRoot"
            PointerPressed="OnPanelPointerPressed">
      <Border.Styles>
        <!--
            Hover outline on the VIRTUAL panel only. The physical side
            already outlines on hover; matching it here signals the panel
            is interactive, and on this side a click opens the slot's
            settings editor.

            BorderBrush ONLY — the thickness stays put. Thickening the
            border on hover changes the panel's content box, which resizes
            the ThemeSurface inside it, which rescales the artwork and
            moves every element under the cursor. The element highlight is
            positioned from the theme geometry the frame BEFORE that
            reflow, so it lands offset from the control it belongs to, and
            it does so only while hovering — which is the one moment you
            are looking at it. That is why the highlight still read as
            misplaced here after the drawing itself was fixed.

            The panel therefore carries its 2px border at all times and
            only changes colour, so hovering costs no layout at all.
        -->
        <Style Selector="Border#PanelRoot">
          <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border#PanelRoot:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>
      </Border.Styles>
      <Border Padding="18,14" CornerRadius="14"
              Background="{Binding PanelOverlayBrush}">
        <!--
            EVERY row except the artwork is a FIXED height, and that is
            load-bearing rather than tidiness.

            ThemeSurface has no intrinsic size — its MeasureOverride
            returns whatever the parent offers — so the artwork is sized
            entirely by what the star row has left over. Any neighbouring
            row that grows steals from it. The pressed-buttons readout
            below updates on every input frame and its text length
            changes with it, so while it was Auto-height a single wrap to
            a second line resized the star row and rescaled the whole
            controller image, mid-press. Reserving the space up front
            means live text can change freely without the artwork moving
            a pixel.
        -->
        <!--
            Row heights INCLUDE their content's margins.

            They did not, and that is what made the readouts overlap. The
            title row was 22 px tall holding content with an 8 px bottom
            margin, and the footer row 20 px holding a 4 px top margin —
            so each asked for more space than its row had, and a fixed row
            does not grow. The surplus was drawn over the neighbouring row
            instead. Rows are deliberately fixed here (see above), which
            means a margin inside one is not a spacing choice, it is an
            overflow: 22+8 and 20+4 are now simply 30 and 24.
        -->
        <Grid RowDefinitions="30,Auto,*,24" MinHeight="260">

            <!-- Title row -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBlock Grid.Column="1" Text="{Binding ConnectionLabel}"
                           FontSize="10" Foreground="{Binding ConnectionBrush}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" LetterSpacing="1" />
            </Grid>

            <!--
                Variant picker — shows every theme installed for the
                current visual style so the user can swap colour/skin
                without leaving the screen. Hidden when no themes are
                installed for the current style.
            -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8"
                  IsVisible="{Binding HasThemeVariants}">
                <TextBlock Text="Skin" VerticalAlignment="Center" Margin="0,0,10,0"
                           Classes="sectionLabel" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableThemeVariants}"
                          SelectedItem="{Binding SelectedThemeVariant, Mode=TwoWay}"
                          MinHeight="30" FontSize="11"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="NoThemeMessage"
                           IsVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource AppForegroundDim}" FontSize="12"
                           Text="No controller theme installed for this style. Drop a VSCView-compatible theme folder into %LocalAppData%\GAMEFLOW\themes." />
                <views:ThemeSurface x:Name="ThemedSurface"
                                    IsVisible="{Binding IsThemedStyle}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />

                <!--
                    Keyboards get the real keyboard, not a theme pack.
                    This is the same control the Devices page draws, so
                    the same hardware now looks the same in both places —
                    it did not before, because the dashboard went through
                    the theme engine and one of its two keyboard packs
                    ships no art at all.
                -->
                <Viewbox IsVisible="{Binding IsKeyboardStyle}"
                         Stretch="Uniform" StretchDirection="DownOnly">
                  <views:KeyboardSurface />
                </Viewbox>
            </Grid>

            <!-- Live pressed-button readout. Single line by contract:
                 see the note on the row definitions above. -->
            <TextBlock Grid.Row="3" Text="{Binding PressedButtonsText}"
                       FontSize="11"
                       VerticalAlignment="Bottom"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AppForegroundDim}" />
        </Grid>
    </Border>
    </Border>
</UserControl>
