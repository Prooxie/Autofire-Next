<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameFlow.App.Views.RequirementsDialog"
        Width="640"
        SizeToContent="Height"
        MinWidth="540"
        MinHeight="320"
        MaxHeight="720"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}"
        Title="Missing requirements">

  <Border Margin="0"
          ClipToBounds="True"
          Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}"
          BorderThickness="1">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20" RowSpacing="16">

      <!-- Header -->
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="Some optional components aren't installed"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppForeground}" />
        <TextBlock Text="GameFlow can run without them, but parts of the feature set will be unavailable until they're installed."
                   FontSize="12"
                   Foreground="{DynamicResource AppForegroundDim}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Per-requirement list — populated from code-behind -->
      <ScrollViewer Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="RequirementsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,0,8,10" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="11.5"
                               Foreground="{DynamicResource AppForegroundDim}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="ghost"
                          Content="Open install page"
                          Tag="{Binding}"
                          Click="OnOpenInstallPageClick"
                          VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Footer buttons -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <CheckBox Grid.Column="0"
                  Name="DontAskAgainCheckbox"
                  Content="Don't check at startup again"
                  VerticalAlignment="Center" />

        <Button Grid.Column="2"
                Content="Close"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseClick"
                Classes="primary"
                Padding="20,9" />
      </Grid>

    </Grid>
  </Border>
</Window>
