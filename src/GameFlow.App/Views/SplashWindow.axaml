<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameFlow.App.Views.SplashWindow"
        Title="GameFlow"
        Width="720"
        Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurface0}"
        WindowDecorations="Full">

  <Border Margin="0"
          CornerRadius="18"
          ClipToBounds="True"
          Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}"
          BorderThickness="1">
    <Grid RowDefinitions="*,Auto">

      <!-- Background layer — art removed by request: the splash is the
           wordmark on the gradient, nothing else. -->
      <Grid Grid.Row="0">
        <!-- Gradient vignette -->
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#00050B12" Offset="0.0" />
              <GradientStop Color="#CC050B12" Offset="0.5" />
              <GradientStop Color="#FF050B12" Offset="1.0" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- Horizontal accent glow strip -->
        <Border VerticalAlignment="Bottom" Height="1" Margin="0,0,0,100">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#00050B12" Offset="0.0" />
              <GradientStop Color="#6600D4FF" Offset="0.4" />
              <GradientStop Color="#6600D4FF" Offset="0.6" />
              <GradientStop Color="#00050B12" Offset="1.0" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- Wordmark — THE logo now: the art's own baked-in wordmark was
             cropped out (it pinned the logo/title to the top half and
             duplicated this block), so this is centered and sized to
             carry the splash. -->
        <StackPanel Margin="40,0,40,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="16"
                    Background="{DynamicResource AppAccentSoft}"
                    BorderBrush="{DynamicResource AppAccent}"
                    BorderThickness="2"
                    VerticalAlignment="Center">
              <TextBlock Text="⊕" FontSize="34" FontWeight="Black"
                         Foreground="{DynamicResource AppAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- Single-line two-tone wordmark — see ShellWindow.axaml for why this replaced stacked two-line text. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
              <TextBlock Text="GAME" FontSize="46" FontWeight="Black"
                         Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" LetterSpacing="1.5" />
              <TextBlock Text="FLOW" FontSize="46" FontWeight="Black"
                         Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" LetterSpacing="1.5" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="Cross-platform controller remapping, autofire &amp; speedrun tooling"
                     FontSize="14"
                     Foreground="{DynamicResource AppForegroundDim}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Loading footer -->
      <Border Grid.Row="1"
              Padding="40,18,40,24"
              Background="{DynamicResource AppSurface0}"
              BorderBrush="{DynamicResource AppBorder0}"
              BorderThickness="0,1,0,0">
        <StackPanel Spacing="10">
          <ProgressBar IsIndeterminate="True" Height="2" CornerRadius="1" />
          <TextBlock Text="Bootstrapping host, runtime pipeline, profile store and translations…"
                     FontSize="12"
                     Foreground="{DynamicResource AppForegroundDim}" />
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</Window>
