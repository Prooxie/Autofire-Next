<UserControl xmlns="https://github.com/avaloniaui"
             x:Name="EditorRoot"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameFlow.App.ViewModels"
             x:Class="GameFlow.App.Views.MappingEditorView"
             x:DataType="vm:MappingEditorViewModel"
             x:CompileBindings="True">

  <UserControl.Resources>
    <DataTemplate x:Key="RuleKindTemplate" x:DataType="vm:RuleKindOption">
      <StackPanel Margin="0,3" Spacing="2">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppForeground}" />
        <TextBlock Text="{Binding Description}" FontSize="11"
                   Foreground="{DynamicResource AppForegroundDim}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The edit form was pinned at exactly 430px. That is wide enough for
       its two-column field rows but it never yields, so as the window
       approached its minimum the rule list to its left was squeezed
       toward zero instead of the two panes sharing the loss. A floor plus
       a cap lets the form shrink to a still-usable 340 and stop growing
       past 470, where the fields just stretch without gaining anything.

       These two floors plus this Grid's own margin and gutter are what
       set the 654 MinWidth on the column that hosts this control, over
       in ShellWindow. Raising either one without raising that number
       pushes this pane off the right edge of the window at its minimum
       size instead of shrinking it. -->
  <Grid ColumnSpacing="14" Margin="20,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="260" />
      <ColumnDefinition Width="0.62*" MinWidth="340" MaxWidth="470" />
    </Grid.ColumnDefinitions>

    <!-- ══ LEFT: Rule list ══════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,*" RowSpacing="12">

      <!-- Add toolbar -->
      <Border Grid.Row="0" Padding="14,12" CornerRadius="14"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding MappingRulesHeaderLabel}" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="1" />
            <ComboBox ItemsSource="{Binding RuleKindOptions}"
                      SelectedItem="{Binding SelectedNewRuleKind}"
                      ItemTemplate="{StaticResource RuleKindTemplate}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" VerticalAlignment="Bottom"
                  Padding="16,10" Command="{Binding AddRuleCommand}"
                  Content="{Binding AddRuleButtonLabel}" />
        </Grid>
      </Border>

      <!-- Rule cards -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Rules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="12"
                      Background="{DynamicResource AppSurface1}"
                      BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                  <!-- Badge + enable toggle -->
                  <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Top">
                    <Border Padding="8,4" CornerRadius="6"
                            Background="{Binding KindBadgeColor}">
                      <TextBlock Text="{Binding KindLabel}" FontSize="9.5"
                                 FontWeight="Bold" Foreground="{DynamicResource AppBadgeForeground}"
                                 LetterSpacing="0.5" />
                    </Border>
                    <CheckBox IsChecked="{Binding Enabled}"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="Enable / disable this rule" />
                  </StackPanel>

                  <!-- Name + summary -->
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               FontSize="13" Foreground="{DynamicResource AppForeground}" />
                    <!-- MaxLines, not MaxHeight: the height cap sliced the
                         third line horizontally through the letterforms,
                         which looks like a clipping bug rather than
                         deliberate truncation. -->
                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5"
                               Foreground="{DynamicResource AppForegroundDim}"
                               TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SummaryText}"
                               FontFamily="Cascadia Code,Consolas,monospace" />
                  </StackPanel>

                  <!-- Action buttons -->
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                    <Button Classes="ghost" Padding="10,6" FontSize="12"
                            Command="{Binding #EditorRoot.DataContext.EditRuleCommand}"
                            CommandParameter="{Binding}"
                            Content="{Binding #EditorRoot.DataContext.EditButtonLabel}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                      <Button Grid.Column="0" Classes="ghost" Padding="6,5" FontSize="11"
                              Command="{Binding #EditorRoot.DataContext.MoveUpCommand}"
                              CommandParameter="{Binding}"
                              Content="↑" ToolTip.Tip="Move up" />
                      <Button Grid.Column="1" Classes="ghost" Padding="6,5" FontSize="11"
                              Command="{Binding #EditorRoot.DataContext.MoveDownCommand}"
                              CommandParameter="{Binding}"
                              Content="↓" ToolTip.Tip="Move down" />
                    </Grid>
                    <Button Classes="danger" Padding="10,5" FontSize="11"
                            Command="{Binding #EditorRoot.DataContext.DeleteRuleCommand}"
                            CommandParameter="{Binding}"
                            Content="{Binding #EditorRoot.DataContext.DeleteButtonLabel}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- ══ RIGHT: Edit form ══════════════════════════════════════════ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="0">

      <!-- Empty state -->
      <Border Grid.Row="0" Grid.RowSpan="2"
              Padding="24" CornerRadius="16"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1"
              IsVisible="{Binding IsNotEditing}"
              VerticalAlignment="Top">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <TextBlock Text="⊞" FontSize="32" Foreground="{DynamicResource AppBorder1}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding SelectRuleToEditLabel}" FontSize="14"
                     FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundDim}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding OrUseAddRuleLabel}"
                     FontSize="12" Foreground="{DynamicResource AppBorder1}"
                     TextWrapping="Wrap" HorizontalAlignment="Center"
                     TextAlignment="Center" MaxWidth="240" />
        </StackPanel>
      </Border>

      <!-- Edit form -->
      <Border Grid.Row="0" Grid.RowSpan="2"
              CornerRadius="16"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1"
              IsVisible="{Binding IsEditing}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,18" Spacing="16"
                      DataContext="{Binding EditingRule}">

            <!-- Form header -->
            <StackPanel Spacing="3">
              <Border Padding="10,5" CornerRadius="6"
                      Background="{Binding KindBadgeColor}"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                           FontWeight="Bold" Foreground="{DynamicResource AppBadgeForeground}" LetterSpacing="0.5" />
              </Border>
              <TextBlock Text="{Binding #EditorRoot.DataContext.EditPanelTitle, FallbackValue='Edit rule'}"
                         FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource AppForeground}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Classes="divider" />

            <!-- ── Common fields ──────────────────────────────────── -->
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding #EditorRoot.DataContext.RuleNameLabel}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="0.8" />
              <TextBox Text="{Binding Name}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.RuleTypeLabel}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding KindOptions}"
                          SelectedItem="{Binding SelectedKindOption}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.RuleModeLabel}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding ModeOptions}"
                          SelectedItem="{Binding SelectedModeOption}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Bottom">
                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding #EditorRoot.DataContext.EnabledLabel}" />
              </StackPanel>
            </Grid>

            <!-- ── Button remap fields ─────────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsButtonRemap}">
              <Border Classes="divider" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SourceButtonLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppInfo}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding ButtonOptions}"
                            SelectedItem="{Binding SelectedSourceButtonOption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.TargetButtonLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppInfo}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding ButtonOptions}"
                            SelectedItem="{Binding SelectedTargetButtonOption}" />
                </StackPanel>
              </Grid>
              <CheckBox IsChecked="{Binding SuppressSourceButton}"
                        Content="{Binding #EditorRoot.DataContext.SuppressSourceButtonLabel}" />
            </StackPanel>

            <!-- ── Button autofire fields ──────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsButtonAutofire}">
              <Border Classes="divider" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTriggerButtonLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppWarning}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding ButtonOptions}"
                            SelectedItem="{Binding SelectedSourceButtonOption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionOutputButtonLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppWarning}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding ButtonOptions}"
                            SelectedItem="{Binding SelectedTargetButtonOption}" />
                </StackPanel>
              </Grid>
              <CheckBox IsChecked="{Binding SuppressSourceButton}"
                        Content="{Binding #EditorRoot.DataContext.SuppressSourceButtonLabel}" />
            </StackPanel>

            <!-- ── Stick threshold fields ──────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsStickThreshold}">
              <Border Classes="divider" />
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTargetStickLabel}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppSuccess}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding StickOptions}"
                          SelectedItem="{Binding SelectedTargetStickOption}" />
              </StackPanel>
              <CheckBox IsChecked="{Binding SuppressThresholdSourceStick}"
                        Content="{Binding #EditorRoot.DataContext.SuppressRawAfterShapingLabel}" />
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionDeadzoneLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppSuccess}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding DeadzoneText}"
                             FontSize="12" Foreground="{DynamicResource AppAccent}"
                             FontFamily="Cascadia Code,Consolas,monospace" />
                </Grid>
                <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                  <Slider Grid.Column="0" Minimum="0" Maximum="0.50" SmallChange="0.01"
                          LargeChange="0.05" Value="{Binding Deadzone}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding DeadzoneInput, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding #EditorRoot.DataContext.HintDeadzoneLabel}"
                           FontSize="11" Foreground="{DynamicResource AppForegroundDim}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionFullAtLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppSuccess}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding FullAtText}"
                             FontSize="12" Foreground="{DynamicResource AppAccent}"
                             FontFamily="Cascadia Code,Consolas,monospace" />
                </Grid>
                <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                  <Slider Grid.Column="0" Minimum="0.50" Maximum="1.0" SmallChange="0.01"
                          LargeChange="0.05" Value="{Binding FullAt}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding FullAtInput, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding #EditorRoot.DataContext.HintFullAtLabel}"
                           FontSize="11" Foreground="{DynamicResource AppForegroundDim}" />
              </StackPanel>
            </StackPanel>

            <!-- ── Stick autofire fields ───────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsStickAutofire}">
              <Border Classes="divider" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionSourceStickLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppFeature}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding StickOptions}"
                            SelectedItem="{Binding SelectedSourceStickOption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTargetStickLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppFeature}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding StickOptions}"
                            SelectedItem="{Binding SelectedTargetStickOption}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionBlendModeLabel}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppFeature}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding BlendModeOptions}"
                          SelectedItem="{Binding SelectedBlendModeOption}" />
              </StackPanel>
              <CheckBox IsChecked="{Binding SuppressSourceStick}"
                        Content="{Binding #EditorRoot.DataContext.SuppressSourceStickOutputLabel}" />
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionActivationDeadzoneLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppFeature}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding DeadzoneText}"
                             FontSize="12" Foreground="{DynamicResource AppAccent}"
                             FontFamily="Cascadia Code,Consolas,monospace" />
                </Grid>
                <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                  <Slider Grid.Column="0" Minimum="0" Maximum="0.50" SmallChange="0.01"
                          Value="{Binding Deadzone}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding DeadzoneInput, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionActivationFullAtLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppFeature}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding FullAtText}"
                             FontSize="12" Foreground="{DynamicResource AppAccent}"
                             FontFamily="Cascadia Code,Consolas,monospace" />
                </Grid>
                <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                  <Slider Grid.Column="0" Minimum="0.50" Maximum="1.0" SmallChange="0.01"
                          Value="{Binding FullAt}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding FullAtInput, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Center" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- ── Script rule fields ──────────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsScriptRule}">
              <Border Classes="divider" />
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTargetControlKeyLabel}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppWarning}" LetterSpacing="0.8" />
                <TextBox Text="{Binding ControlKey}"
                         PlaceholderText="South / LeftStick / RightTrigger.Analog" />
                <CheckBox IsChecked="{Binding SuppressScriptSourceInput}"
                          Content="{Binding #EditorRoot.DataContext.SuppressSourceInputStoredLabel}" />
                <TextBlock Text="{Binding #EditorRoot.DataContext.StoreScriptLabel}"
                           FontSize="11" Foreground="{DynamicResource AppForegroundDim}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionScriptLabel}" FontSize="10" FontWeight="SemiBold"
                              Foreground="{DynamicResource AppWarning}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding ScriptPreviewText}"
                             FontSize="11" Foreground="{DynamicResource AppForegroundDim}"
                             MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBox Classes="code"
                         Text="{Binding ScriptCode}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="180"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </StackPanel>

            <!-- ── Freeze last direction fields ───────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsFreeze}">
              <Border Classes="divider" />
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionActivationButtonLabel}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"
                           LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding ButtonOptions}"
                          SelectedItem="{Binding SelectedActivationButtonOption}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionCaptureStickLabel}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppAccent}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding StickOptions}"
                            SelectedItem="{Binding SelectedCaptureStickOption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.SectionOutputStickLabel}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppAccent}" LetterSpacing="0.8" />
                  <ComboBox ItemsSource="{Binding StickOptions}"
                            SelectedItem="{Binding SelectedTargetStickOption}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionBlendModeLabel}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppAccent}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding BlendModeOptions}"
                          SelectedItem="{Binding SelectedBlendModeOption}" />
              </StackPanel>
              <CheckBox IsChecked="{Binding SuppressActivationButton}"
                        Content="{Binding #EditorRoot.DataContext.SuppressActivationWhileFreezingLabel}" />
              <CheckBox IsChecked="{Binding SuppressCaptureStick}"
                        Content="{Binding #EditorRoot.DataContext.SuppressCapturedWhileFrozenLabel}" />
              <CheckBox IsChecked="{Binding PulseEnabled}"
                        Content="{Binding #EditorRoot.DataContext.PulseWhileFrozenLabel}" />
            </StackPanel>

            <!-- ── Multi-button autofire fields ───────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsMultiButtonAutofire}">
              <Border Classes="divider" />
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTriggerButtonHoldLabel}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppDanger}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding ButtonOptions}"
                          SelectedItem="{Binding SelectedSourceButtonOption}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>
              <CheckBox IsChecked="{Binding SuppressSourceButton}"
                        Content="{Binding #EditorRoot.DataContext.SuppressSourceButtonLabel}" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionSequenceStepsLabel}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppDanger}" LetterSpacing="0.8" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding #EditorRoot.DataContext.AddStepLabel}"
                        Command="{Binding AddStepCommand}"
                        Padding="8,3" FontSize="11" />
              </Grid>

              <TextBlock Text="{Binding #EditorRoot.DataContext.NoStepsYetLabel}"
                         FontSize="11" Foreground="{DynamicResource AppForegroundDim}"
                         TextWrapping="Wrap" IsVisible="{Binding !HasSteps}" />

              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource AppSurface1}" CornerRadius="6"
                            Padding="8" Margin="0,0,0,6">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding #EditorRoot.DataContext.SectionStepTargetLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppDanger}" LetterSpacing="0.8" />
                            <ComboBox ItemsSource="{Binding ButtonOptions}"
                                      SelectedItem="{Binding SelectedTargetButtonOption}"
                                      HorizontalAlignment="Stretch" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="✕"
                                  VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="8,4"
                                  Command="{Binding #EditorRoot.DataContext.EditingRule.RemoveStepCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                          <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding #EditorRoot.DataContext.HoldMsLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForegroundDim}" />
                            <TextBox Text="{Binding HoldMsInput}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding #EditorRoot.DataContext.ReleaseMsLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForegroundDim}" />
                            <TextBox Text="{Binding ReleaseMsInput}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="{Binding #EditorRoot.DataContext.DelayMsLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForegroundDim}" />
                            <TextBox Text="{Binding DelayAfterMsInput}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ── Rule toggle fields ─────────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding IsRuleToggle}">
              <Border Classes="divider" />
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTriggerButtonToggleLabel}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{DynamicResource AppSuccess}" LetterSpacing="0.8" />
                <ComboBox ItemsSource="{Binding ButtonOptions}"
                          SelectedItem="{Binding SelectedSourceButtonOption}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>
              <CheckBox IsChecked="{Binding SuppressSourceButton}"
                        Content="{Binding #EditorRoot.DataContext.SuppressSourceButtonLabel}" />

              <TextBlock Text="{Binding #EditorRoot.DataContext.SectionRulesToToggleLabel}" FontSize="10" FontWeight="SemiBold"
                          Foreground="{DynamicResource AppSuccess}" LetterSpacing="0.8" />
              <TextBlock Text="{Binding #EditorRoot.DataContext.ToggleHintLabel}"
                         FontSize="11" Foreground="{DynamicResource AppForegroundDim}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding #EditorRoot.DataContext.NoOtherRulesLabel}"
                         FontSize="11" Foreground="{DynamicResource AppForegroundDim}"
                         TextWrapping="Wrap" IsVisible="{Binding !HasToggleTargets}" />
              <ItemsControl ItemsSource="{Binding ToggleTargets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}"
                              Content="{Binding RuleName}" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ── Timing fields ──────────────────────────────────── -->
            <StackPanel Spacing="12" IsVisible="{Binding ShowPulseTiming}">
              <Border Classes="divider" />
              <TextBlock Text="{Binding #EditorRoot.DataContext.SectionTimingLabel}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="0.8" />
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.TimingHoldLabel}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding HoldMsText}"
                             FontSize="12" Foreground="{DynamicResource AppAccent}"
                             FontFamily="Cascadia Code,Consolas,monospace" />
                </Grid>
                <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                  <Slider Grid.Column="0" Minimum="8" Maximum="500" SmallChange="4"
                          LargeChange="16" Value="{Binding HoldMs}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding HoldMsInput, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding #EditorRoot.DataContext.HintHoldLabel}"
                           FontSize="11" Foreground="{DynamicResource AppForegroundDim}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding #EditorRoot.DataContext.TimingReleaseLabel}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppForegroundDim}" LetterSpacing="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding ReleaseMsText}"
                             FontSize="12" Foreground="{DynamicResource AppAccent}"
                             FontFamily="Cascadia Code,Consolas,monospace" />
                </Grid>
                <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                  <Slider Grid.Column="0" Minimum="4" Maximum="500" SmallChange="4"
                          LargeChange="16" Value="{Binding ReleaseMs}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding ReleaseMsInput, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding #EditorRoot.DataContext.HintReleaseLabel}"
                           FontSize="11" Foreground="{DynamicResource AppForegroundDim}" />
              </StackPanel>
            </StackPanel>

            <!-- ── Save / Cancel — fix #4: Save rule text centered ── -->
            <Border Classes="divider" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <Button Grid.Column="0"
                      Classes="primary"
                      Padding="0,11"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Command="{Binding #EditorRoot.DataContext.SaveEditCommand, FallbackValue={x:Null}}"
                      Content="{Binding #EditorRoot.DataContext.SaveButtonLabel}" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Padding="16,11"
                      HorizontalContentAlignment="Center"
                      Command="{Binding #EditorRoot.DataContext.CancelEditCommand, FallbackValue={x:Null}}"
                      Content="{Binding #EditorRoot.DataContext.CancelButtonLabel}" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
