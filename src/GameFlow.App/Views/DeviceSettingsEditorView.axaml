<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameFlow.App.ViewModels"
             xmlns:views="using:GameFlow.App.Views"
             x:Class="GameFlow.App.Views.DeviceSettingsEditorView"
             x:DataType="vm:DeviceSettingsEditorViewModel"
             x:CompileBindings="True">

  <UserControl.Styles>
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.sectionHead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.readout">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,6" Spacing="2">
      <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="15"
                 Foreground="{DynamicResource AppForeground}" />
      <TextBlock Text="{Binding TuningScopeDescription}"
                 FontSize="11" Opacity="0.7"
                 Foreground="{DynamicResource AppForeground}" />
    </StackPanel>

    <!-- Status about what reaches hardware today -->
    <Border Grid.Row="1" Padding="8,6" CornerRadius="4" Margin="0,0,0,8"
            Background="#22FFAA33" BorderBrush="#55FFAA33" BorderThickness="1">
      <TextBlock Text="{Binding EffectsStatusNote}" TextWrapping="Wrap"
                 FontSize="11" Foreground="{DynamicResource AppForeground}" />
    </Border>

    <TabControl Grid.Row="2" IsEnabled="{Binding HasDevice}">

      <!-- ── Sticks ── -->
      <TabItem Header="Sticks">
        <ScrollViewer>
          <StackPanel Margin="4,2" Spacing="14">

            <!--
                One block per stick: the curve is the primary control and
                the numbers sit beside it, because a deadzone figure means
                nothing on its own. Drag the handles on the graph or type
                an exact value — both edit the same properties, so they
                stay in step without any extra plumbing.
            -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="sectionHead" Margin="0" Text="Left stick"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Default"
                          Command="{Binding ApplyLeftDefaultCommand}" />
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Precision"
                          Command="{Binding ApplyLeftPrecisionCommand}" />
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Aggressive"
                          Command="{Binding ApplyLeftAggressiveCommand}" />
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Worn pad"
                          Command="{Binding ApplyLeftWornCommand}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0" Classes="inset" Padding="6" Width="210" Height="180">
                  <views:ResponseCurveEditor
                      Deadzone="{Binding LeftDeadzone, Mode=TwoWay}"
                      AntiDeadzone="{Binding LeftAntiDeadzone, Mode=TwoWay}"
                      FullAt="{Binding LeftFullAt, Mode=TwoWay}"
                      Sensitivity="{Binding LeftSensitivity}"
                      Curve="{Binding LeftCurve}"
                      LiveInput="{Binding LeftStickLive}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="6">
                  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Deadzone" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="0.9"
                                   Increment="0.01" FormatString="0.00"
                                   Value="{Binding LeftDeadzone, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="Anti-deadzone" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="0.95"
                                   Increment="0.01" FormatString="0.00"
                                   Value="{Binding LeftAntiDeadzone, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="rowLabel" Text="Full at" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0.05" Maximum="1"
                                   Increment="0.01" FormatString="0.00"
                                   Value="{Binding LeftFullAt, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="rowLabel" Text="Curve" />
                    <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding CurveOptions}"
                              SelectedItem="{Binding LeftCurve, Mode=TwoWay}" />
                  </Grid>

                  <Expander Header="Advanced" FontSize="12">
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="8" RowSpacing="6" Margin="0,6,0,0">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Sensitivity" />
                      <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0.1" Maximum="5"
                                     Increment="0.05" FormatString="0.00"
                                     Value="{Binding LeftSensitivity, Mode=TwoWay}" />

                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="14">
                        <CheckBox Content="Invert X" IsChecked="{Binding LeftInvertX, Mode=TwoWay}"
                                  Foreground="{DynamicResource AppForeground}" />
                        <CheckBox Content="Invert Y" IsChecked="{Binding LeftInvertY, Mode=TwoWay}"
                                  Foreground="{DynamicResource AppForeground}" />
                      </StackPanel>
                    </Grid>
                  </Expander>
                </StackPanel>
              </Grid>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="sectionHead" Margin="0" Text="Right stick"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Default"
                          Command="{Binding ApplyRightDefaultCommand}" />
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Precision"
                          Command="{Binding ApplyRightPrecisionCommand}" />
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Aggressive"
                          Command="{Binding ApplyRightAggressiveCommand}" />
                  <Button Classes="ghost" FontSize="11" Padding="8,3" Content="Worn pad"
                          Command="{Binding ApplyRightWornCommand}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0" Classes="inset" Padding="6" Width="210" Height="180">
                  <views:ResponseCurveEditor
                      Deadzone="{Binding RightDeadzone, Mode=TwoWay}"
                      AntiDeadzone="{Binding RightAntiDeadzone, Mode=TwoWay}"
                      FullAt="{Binding RightFullAt, Mode=TwoWay}"
                      Sensitivity="{Binding RightSensitivity}"
                      Curve="{Binding RightCurve}"
                      LiveInput="{Binding RightStickLive}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="6">
                  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Deadzone" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="0.9"
                                   Increment="0.01" FormatString="0.00"
                                   Value="{Binding RightDeadzone, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="Anti-deadzone" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="0.95"
                                   Increment="0.01" FormatString="0.00"
                                   Value="{Binding RightAntiDeadzone, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="rowLabel" Text="Full at" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0.05" Maximum="1"
                                   Increment="0.01" FormatString="0.00"
                                   Value="{Binding RightFullAt, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="rowLabel" Text="Curve" />
                    <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding CurveOptions}"
                              SelectedItem="{Binding RightCurve, Mode=TwoWay}" />
                  </Grid>

                  <Expander Header="Advanced" FontSize="12">
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="8" RowSpacing="6" Margin="0,6,0,0">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Sensitivity" />
                      <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0.1" Maximum="5"
                                     Increment="0.05" FormatString="0.00"
                                     Value="{Binding RightSensitivity, Mode=TwoWay}" />

                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="14">
                        <CheckBox Content="Invert X" IsChecked="{Binding RightInvertX, Mode=TwoWay}"
                                  Foreground="{DynamicResource AppForeground}" />
                        <CheckBox Content="Invert Y" IsChecked="{Binding RightInvertY, Mode=TwoWay}"
                                  Foreground="{DynamicResource AppForeground}" />
                      </StackPanel>
                    </Grid>
                  </Expander>
                </StackPanel>
              </Grid>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Triggers ── -->
      <TabItem Header="Triggers">
        <ScrollViewer>
          <StackPanel Margin="4,2" Spacing="2">
            <TextBlock Classes="sectionHead" Text="Left trigger" />
            <Grid ColumnDefinitions="130,*,54" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Deadzone" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="0.5" SmallChange="0.01"
                      Value="{Binding LeftTriggerDeadzone}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="readout"
                         Text="{Binding LeftTriggerDeadzone, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="Full at" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0.4" Maximum="1.0" SmallChange="0.01"
                      Value="{Binding LeftTriggerFullAt}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout"
                         Text="{Binding LeftTriggerFullAt, StringFormat='{}{0:P0}'}" />
            </Grid>

            <TextBlock Classes="sectionHead" Text="Right trigger" />
            <Grid ColumnDefinitions="130,*,54" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Deadzone" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="0.5" SmallChange="0.01"
                      Value="{Binding RightTriggerDeadzone}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="readout"
                         Text="{Binding RightTriggerDeadzone, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="Full at" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0.4" Maximum="1.0" SmallChange="0.01"
                      Value="{Binding RightTriggerFullAt}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout"
                         Text="{Binding RightTriggerFullAt, StringFormat='{}{0:P0}'}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Rumble ── -->
      <TabItem Header="Rumble">
        <ScrollViewer>
          <StackPanel Margin="4,2" Spacing="4">
            <CheckBox Content="Rumble enabled" IsChecked="{Binding RumbleEnabled}" />
            <Grid ColumnDefinitions="130,*,54" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Overall gain" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2.0" SmallChange="0.05"
                      Value="{Binding RumbleGain}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="readout"
                         Text="{Binding RumbleGain, StringFormat='{}{0:F2}x'}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="Low motor" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2.0" SmallChange="0.05"
                      Value="{Binding RumbleLowGain}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout"
                         Text="{Binding RumbleLowGain, StringFormat='{}{0:F2}x'}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="rowLabel" Text="High motor" />
              <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="2.0" SmallChange="0.05"
                      Value="{Binding RumbleHighGain}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="readout"
                         Text="{Binding RumbleHighGain, StringFormat='{}{0:F2}x'}" />
            </Grid>
            <CheckBox Content="Swap left/right motors" IsChecked="{Binding RumbleSwapMotors}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Lighting ── -->
      <TabItem Header="Lighting">
        <ScrollViewer>
          <StackPanel Margin="4,2" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="rowLabel" Text="Lightbar mode" Width="120" />
              <ComboBox ItemsSource="{Binding LightbarModeOptions}"
                        SelectedItem="{Binding LightbarMode}" Width="190" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="rowLabel" Text="Colour (hex)" Width="120" />
              <TextBox Text="{Binding LightbarColor}" Width="120" />
            </StackPanel>
            <Grid ColumnDefinitions="130,*,54" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Brightness" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.05"
                      Value="{Binding LightbarBrightness}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="readout"
                         Text="{Binding LightbarBrightness, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="Player LEDs" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.05"
                      Value="{Binding IndicatorBrightness}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout"
                         Text="{Binding IndicatorBrightness, StringFormat='{}{0:P0}'}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Adaptive triggers ── -->
      <TabItem Header="Adaptive">
        <ScrollViewer>
          <StackPanel Margin="4,2" Spacing="2">

            <TextBlock Classes="sectionHead" Text="Left adaptive trigger" />
            <ComboBox ItemsSource="{Binding AdaptiveModeOptions}"
                      SelectedItem="{Binding LeftAdaptiveMode}" Width="230" />
            <Grid ColumnDefinitions="130,*,54" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Start" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.02"
                      Value="{Binding LeftAdaptiveStart}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="readout"
                         Text="{Binding LeftAdaptiveStart, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="End" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.02"
                      Value="{Binding LeftAdaptiveEnd}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout"
                         Text="{Binding LeftAdaptiveEnd, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="rowLabel" Text="Strength" />
              <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.05"
                      Value="{Binding LeftAdaptiveStrength}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="readout"
                         Text="{Binding LeftAdaptiveStrength, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="rowLabel" Text="Frequency (Hz)" />
              <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="60" SmallChange="1"
                      Value="{Binding LeftAdaptiveFrequency}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="readout"
                         Text="{Binding LeftAdaptiveFrequency}" />
            </Grid>

            <TextBlock Classes="sectionHead" Text="Right adaptive trigger" />
            <ComboBox ItemsSource="{Binding AdaptiveModeOptions}"
                      SelectedItem="{Binding RightAdaptiveMode}" Width="230" />
            <Grid ColumnDefinitions="130,*,54" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="rowLabel" Text="Start" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.02"
                      Value="{Binding RightAdaptiveStart}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="readout"
                         Text="{Binding RightAdaptiveStart, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="rowLabel" Text="End" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.02"
                      Value="{Binding RightAdaptiveEnd}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout"
                         Text="{Binding RightAdaptiveEnd, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="rowLabel" Text="Strength" />
              <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1.0" SmallChange="0.05"
                      Value="{Binding RightAdaptiveStrength}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="readout"
                         Text="{Binding RightAdaptiveStrength, StringFormat='{}{0:P0}'}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="rowLabel" Text="Frequency (Hz)" />
              <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="60" SmallChange="1"
                      Value="{Binding RightAdaptiveFrequency}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="readout"
                         Text="{Binding RightAdaptiveFrequency}" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
