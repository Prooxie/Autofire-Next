<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GameFlow.App.Views"
        xmlns:vm="using:GameFlow.App.ViewModels"
        x:Class="GameFlow.App.Views.ShellWindow"
        x:Name="ShellRoot"
        x:DataType="vm:ShellViewModel"
        x:CompileBindings="False"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppSurface0}"
        Title="{Binding WindowTitle}">

  <!--
      FitToWorkingArea clamps this compact default to 92% of the primary
      monitor's logical working area before the first Show(). Using logical
      pixels matters on high-DPI desktops, while the working area reserves
      taskbar space. The minimums are lowered by the same clamp when a small
      display cannot satisfy them.
  -->

  <Window.Resources>
    <DataTemplate x:Key="InputProviderTemplate">
      <StackPanel Margin="0,4" Spacing="3">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" />
        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundDim}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ControllerStyleTemplate">
      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource AppForeground}" />
    </DataTemplate>

    <DataTemplate x:Key="DetectedControllerTemplate">
      <StackPanel Margin="0,4" Spacing="3">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" />
        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundDim}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ProfileOptionTemplate">
      <StackPanel Margin="0,4" Spacing="3">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" />
        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundDim}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*" RowSpacing="0">

    <!-- ── Header ─────────────────────────────────────────────────── -->
    <!--
        Auto-height, not a fixed pixel row: the row is exactly as tall as
        its content plus this padding, on purpose. Three attempts at
        centering content within a taller fixed-height row (88px) never
        visibly worked — screenshots kept showing the wordmark clustered
        at the top with a large unexplained gap below it, regardless of
        VerticalAlignment/RowDefinitions="*,Auto,*" changes that should
        have centered it. Rather than keep chasing that, this sidesteps
        the whole class of problem: with no excess row height to center
        within, symmetric top/bottom padding is centering by definition.
    -->
    <Border Grid.Row="0"
            Padding="20,10"
            Background="{DynamicResource AppSurface1}"
            BorderBrush="{DynamicResource AppBorder0}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">

        <!-- Wordmark + status — LEFT-aligned, vertically centered in
             the header band, sized up from the original tiny variant. -->
        <StackPanel Grid.Column="0" Spacing="2"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                      HorizontalAlignment="Left">
            <Border Width="30" Height="30" CornerRadius="8"
                    Background="{DynamicResource AppAccentSoft}"
                    BorderBrush="{DynamicResource AppAccent}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <TextBlock Text="⊕" FontSize="15" FontWeight="Bold"
                         Foreground="{DynamicResource AppAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!--
                Single-line, two-tone wordmark. Deliberately not stacked
                two-line text: a single shared baseline next to the icon
                is what actually guarantees vertical centering, rather
                than relying on two differently-sized lines happening to
                average out.
            -->
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
              <TextBlock Text="GAME" FontSize="20" FontWeight="Black"
                         Foreground="{DynamicResource AppForeground}"
                         VerticalAlignment="Center"
                         LetterSpacing="0.8" />
              <TextBlock Text="FLOW" FontSize="20" FontWeight="Black"
                         Foreground="{DynamicResource AppAccent}"
                         VerticalAlignment="Center"
                         LetterSpacing="0.8" />
            </StackPanel>
          </StackPanel>
          <!--
              Flush with the icon's own left edge (no indent to align under
              "GAMEFLOW" anymore) — a smaller, quieter second line directly
              below the logo, not offset under the title.
          -->
          <TextBlock Text="{x:Static vm:ShellViewModel.AppFooterText}"
                     FontSize="10.5"
                     Height="14"
                     HorizontalAlignment="Left"
                     Foreground="{DynamicResource AppForegroundDim}" />
          <!--
              Fixed height, not Auto. This line carries transient status
              ("Profile saved", "Import failed: …") and is empty the rest
              of the time. On an Auto height the header row grew and shrank
              with it, and because the header is row 0 of the window grid
              every page below jumped a line each time a status appeared or
              expired. Reserving the line keeps the shell still.
          -->
          <TextBlock Text="{Binding StatusText}" FontSize="10"
                     Height="13"
                     Foreground="{DynamicResource AppForegroundDim}"
                     HorizontalAlignment="Left"
                     MaxWidth="1000"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Language + Theme moved to Settings dialog (Localization & Appearance) -->

        <!-- Right slot reserved for future quick-actions -->
        <Border Grid.Column="2" Width="1" />
      </Grid>
    </Border>

    <!-- ── Sidebar + content ──────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="240,*" ColumnSpacing="0">

      <!-- Single unified navigation column: the section nav (Dashboard /
           Profiles / Devices) sits at the top, the Compact device
           + slot lists fill the middle, and Options is pinned at the
           bottom. This used to be TWO side-by-side columns — this 240px
           sidebar PLUS the TabControl's own 210px left tab strip — which
           burned 450px of width on navigation; the tab strip is now
           hidden (see the TabControl styles below) and this ListBox
           drives the same OuterNavSelectedIndex. -->
      <Border Grid.Column="0"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Section navigation -->
          <StackPanel Grid.Row="0" Margin="10,14,10,0" Spacing="6">
            <ListBox SelectedIndex="{Binding OuterNavSelectedIndex, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="8,8" />
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="CornerRadius" Value="6" />
                </Style>
              </ListBox.Styles>
              <ListBoxItem>
                <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="▣" FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DashboardTabLabel}"
                             FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="≡" FontSize="15" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ProfilesTabLabel}"
                             FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem>
                <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="⊟" FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DevicesTabLabel}"
                             FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
              </ListBoxItem>
            </ListBox>
            <Border Classes="divider" Margin="0,6,0,0" />
          </StackPanel>

          <!-- Device + slot lists -->
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,10" Spacing="6">
            <TextBlock Text="{Binding SidebarPhysicalHeader}" Classes="sectionLabel"
                       Margin="8,4,0,4" />
            <ItemsControl ItemsSource="{Binding PhysicalMenuItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                    <Button Grid.Column="0" Classes="nav" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="{Binding IconText}"
                                   FontSize="14" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SecondaryText}" FontSize="9.5"
                                     Foreground="{DynamicResource AppForegroundDim}"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasSecondaryText}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="chip" Padding="5,2" Margin="3,0,0,0"
                                IsVisible="{Binding HasBattery}"
                                ToolTip.Tip="{Binding BatteryTooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="{Binding BatteryIcon}" FontSize="9"
                                       Foreground="{Binding BatteryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BatteryText}" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{Binding BatteryBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Button>
                    <!-- Pin toggle is a sibling of the select action, not a
                         nested Button, so pinning cannot also activate the row. -->
                    <Button Grid.Column="1" Classes="iconOnly"
                            Margin="0,1"
                            IsVisible="{Binding CanPin}"
                            Command="{Binding PinCommand}"
                            ToolTip.Tip="{Binding PinTooltip}"
                            Content="{Binding PinIcon}" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="(none)" FontSize="11" Margin="14,2"
                       Foreground="{DynamicResource AppForegroundDim}"
                       IsVisible="{Binding !PhysicalMenuItems.Count}" />

            <Border Classes="divider" Margin="0,10,0,4" />

            <TextBlock Text="{Binding SidebarVirtualHeader}" Classes="sectionLabel"
                       Margin="8,4,0,4" />
            <ItemsControl ItemsSource="{Binding VirtualMenuItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="nav" Command="{Binding SelectCommand}">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                      <TextBlock Grid.Column="0" Text="{Binding IconText}"
                                 FontSize="14" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SecondaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource AppForegroundDim}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasSecondaryText}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="nav" Command="{Binding AddVirtualControllerCommand}">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="＋" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppAccent}" />
                <TextBlock Grid.Column="1" Text="{Binding SidebarAddControllerLabel}"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource AppForegroundDim}" />
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

          <!-- Options — pinned at the bottom of the unified sidebar
               (moved here from the old overlay over the now-hidden tab
               strip). -->
          <StackPanel Grid.Row="2" Margin="10,0,10,10" Spacing="6">
            <Border Classes="divider" Margin="0,0,0,4" />
            <Button Classes="nav" Padding="8,8"
                    Command="{Binding OpenSettingsCommand}">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="⚙" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OpenSettingsButtonLabel}"
                           FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Column="1" Name="OuterNavTabs" TabStripPlacement="Left"
                  SelectedIndex="{Binding OuterNavSelectedIndex, Mode=TwoWay}">

        <TabControl.Styles>
          <!-- Section navigation lives in the unified sidebar (left
               column); this TabControl only hosts the CONTENT, so its
               own header strip is hidden. Both rules are scoped to
               #OuterNavTabs so the inner Physical/Virtual sub-tabs on
               the Devices page keep their headers. Selection is still
               driven through OuterNavSelectedIndex, which the sidebar's
               nav ListBox binds two-way.

               Matched by TYPE, not by name: an earlier attempt targeted
               "TabStrip" and a later one "ItemsPresenter#PART_ItemsPresenter",
               and neither part exists in the template Avalonia 12 ships —
               so both rules silently matched nothing and only the
               belt-and-braces TabItem rule below was doing the work. A
               bare type selector cannot go stale the same way. -->
          <Style Selector="TabControl#OuterNavTabs /template/ ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <!-- Belt and braces: even if a theme renames the presenter
               part, zero-size invisible items leave no strip. Child
               combinator keeps this off the nested Devices TabControl. -->
          <Style Selector="TabControl#OuterNavTabs > TabItem">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </TabControl.Styles>

        <!-- ═══ DASHBOARD ══════════════════════════════════════════════ -->
        <TabItem>

          <!--
              AllowAutoHide=False keeps the scroll bar in the layout at a
              constant width instead of overlaying the content on hover.
              This replaces a hardcoded 22px right padding that stood in
              for the bar: that guess was applied whether or not the page
              actually overflowed, so short dashboards sat visibly
              off-centre, and it did nothing to stop the reflow when the
              bar appeared as slots were added.
          -->
          <ScrollViewer Margin="20,16"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        AllowAutoHide="False">
            <StackPanel Spacing="16" Margin="0,0,10,0">

              <!-- Streaming / chroma-key background picker. Chroma green and
                   chroma blue are OBS-standard key colours, so a streamer can
                   key the controller panel onto a webcam feed. Persists with
                   the dashboard preferences. -->
              <StackPanel Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding DashboardBackgroundLabel}" FontSize="11"
                           Foreground="{DynamicResource AppForegroundDim}"
                           VerticalAlignment="Center" />
                <ComboBox MinWidth="170"
                          ItemsSource="{Binding PanelBackgroundOptions}"
                          SelectedItem="{Binding SelectedPanelBackgroundOption, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- PadForge-inspired slot overview: the dashboard answers
                   what each virtual controller is, what drives it, and
                   whether it is ready before asking the user to inspect a
                   full live controller surface. Clicking a card opens that
                   exact slot's focused configuration. -->
              <StackPanel Spacing="9" IsVisible="{Binding SlotsPanel.Slots.Count}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="VIRTUAL CONTROLLERS" Classes="sectionLabel"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Padding="8,4" FontSize="11"
                          Content="+ Add controller" Command="{Binding AddVirtualControllerCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SlotsPanel.Slots}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="228" MinHeight="116" Margin="0,0,10,10" Padding="0"
                              Background="Transparent" BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding #ShellRoot.DataContext.OpenVirtualControllerCommand}"
                              CommandParameter="{Binding Id}">
                        <Border Classes="card" Padding="12" BorderBrush="{Binding StatusBrush}"
                                HorizontalAlignment="Stretch">
                          <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                              <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                      Background="{DynamicResource AppAccentSoft}">
                                <TextBlock Text="{Binding OutputIcon}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SlotLabel}" Classes="sectionLabel" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="2" CornerRadius="12" MinWidth="58" Height="24"
                                      Padding="8,0" VerticalAlignment="Center"
                                      BorderBrush="{Binding StatusBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}"
                                           FontSize="9" FontWeight="SemiBold" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                       Foreground="{DynamicResource AppAccentHover}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DeviceSummary}" Classes="hint"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding ProfileSummary}" FontSize="10"
                                       Foreground="{DynamicResource AppForegroundDim}" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>



              <!--
                  When emulation is off (Preview / None output), the
                  virtual panel hides and the physical panel takes the
                  full row width — matching design point 5 (only the
                  source controller is meaningful when nothing's being
                  emitted).

                  Each surface is wrapped in a Border that keeps the
                  shell's DataContext inherited; we override DataContext
                  only on the inner ControllerSurface so IsVisible
                  resolves against the shell while the surface's own
                  bindings resolve against its per-panel VM.
              -->
              <!--
                  The top-level physical/virtual pair was removed: it was
                  fed by the single-pipeline snapshot store, which never
                  updates while slots are active (which is effectively
                  always) — so it sat there stale. Every slot below gets
                  its own genuine physical/virtual pair instead.
              -->

              <!-- Empty state: no enabled slot currently has a connected
                   device. Without this, the removal of the stale top-level
                   panel left a blank area here with zero explanation. -->
              <Border MinHeight="320" IsVisible="{Binding HasNoControllerPanels}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" Opacity="0.35" />
                  <TextBlock Text="{Binding NoControllerConnectedLabel}"
                             FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppForegroundDim}"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Per-slot live controller panels (Phase 3 dashboard).
                   Each slot gets a genuine physical-vs-virtual comparison
                   at the same size/style as the top-level pair — not the
                   small virtual-only card this used to be — so background
                   choices are visible on both sides and it's actually
                   useful for seeing what a slot's mapping changed. -->
              <StackPanel Spacing="18" IsVisible="{Binding HasControllerPanels}">
                <ItemsControl ItemsSource="{Binding ControllerPanels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="8" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                          <!-- Lightbar chip — only rendered while lighting is
                               actually on; a transparent fill with a visible
                               border used to leave an empty box here. -->
                          <Border Grid.Column="1" Width="40" Height="10" CornerRadius="3"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasLightColor}"
                                  Background="{Binding LightColor}"
                                  BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1" />
                        </Grid>
                        <Grid ColumnSpacing="14">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PhysicalColumnWidth}" />
                            <ColumnDefinition Width="{Binding VirtualColumnWidth}" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0"
                                  IsVisible="{Binding ShowPhysical}">
                            <views:ControllerSurface DataContext="{Binding PhysicalVisual}" />
                          </Border>
                          <Border Grid.Column="1"
                                  IsVisible="{Binding ShowVirtual}">
                            <views:ControllerSurface DataContext="{Binding VirtualVisual}" />
                            <!--
                                Badge lives in the same cell as the virtual
                                surface, anchored top-right, so it's an
                                overlay rather than pushing layout around.
                                Unmistakable at a glance which side is the
                                app's own emitted device — this is also the
                                device this app hides from its own input
                                list (see RuntimeCoordinator's hardware-
                                signature filtering); it's real hardware to
                                every OTHER application, just not to itself.
                            -->
                          </Border>
                           <!-- Compact output warning. The concise explanation
                                and full technical status live in the tooltip,
                                keeping paths and diagnostics off the artwork. -->
                           <Border Grid.Column="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,10,82,0" Padding="7,3" CornerRadius="10"
                                  Background="{DynamicResource AppWarningSoft}"
                                  BorderBrush="{DynamicResource AppWarning}" BorderThickness="1"
                                  IsVisible="{Binding HasOutputWarning}">
                             <ToolTip.Tip>
                              <StackPanel Spacing="5" MaxWidth="360">
                                <TextBlock Text="{Binding OutputWarningText}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OutputStatus}"
                                           Classes="hint" FontSize="10.5" />
                              </StackPanel>
                             </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Text="⚠" FontSize="10"
                                         Foreground="{DynamicResource AppWarning}"
                                         VerticalAlignment="Center" />
                              <TextBlock Text="NO OUTPUT" FontSize="9"
                                         FontWeight="Bold" LetterSpacing="0.6"
                                         Foreground="{DynamicResource AppWarning}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,10,10,0" Padding="7,3" CornerRadius="10"
                                  Background="{DynamicResource AppAccent}"
                                  IsVisible="{Binding ShowVirtual}"
                                  IsHitTestVisible="False">
                            <TextBlock Text="{Binding VirtualBadgeLabel}"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="0.6"
                                       Foreground="{DynamicResource AppSurface0}" />
                          </Border>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ PROFILES ══════════════════════════════════════════════ -->
        <TabItem>

          <Grid Margin="20,16" RowDefinitions="Auto,Auto,*" RowSpacing="14">
            <Border Grid.Row="0" Classes="panel" Padding="18,16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileEditorLabel}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="{Binding ProfileToolbarSubtitle}"
                               FontSize="12" Foreground="{DynamicResource AppForegroundDim}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <!--
                      WrapPanel, not a horizontal StackPanel: seven
                      buttons whose labels are translated into eight
                      languages overflowed the row on the longer ones
                      (German and Czech in particular), and a horizontal
                      StackPanel has no way to give — it just pushed the
                      title text into an ellipsis and clipped the last
                      button off the card. Wrapping trades a second row
                      of buttons for keeping all of them reachable.
                  -->
                  <WrapPanel Grid.Column="1" Orientation="Horizontal"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             MaxWidth="740">
                    <Button Classes="ghost" Margin="0,0,8,4"
                            Command="{Binding CreateProfileCommand}"
                            Content="{Binding CreateProfileButtonLabel}" />
                    <Button Classes="ghost" Margin="0,0,8,4"
                            Command="{Binding DuplicateProfileCommand}"
                            Content="{Binding DuplicateProfileButtonLabel}" />
                    <Button Classes="ghost" Margin="0,0,8,4"
                            Command="{Binding ImportProfileCommand}"
                            Content="{Binding ImportProfileButtonLabel}" />
                    <Button Classes="ghost" Margin="0,0,8,4"
                            Command="{Binding ExportProfileCommand}"
                            Content="{Binding ExportProfileButtonLabel}" />
                    <Button Classes="danger" Margin="0,0,8,4"
                            Command="{Binding DeleteProfileCommand}"
                            Content="{Binding DeleteProfileButtonLabel}" />
                    <Button Classes="ghost" Margin="0,0,8,4"
                            Command="{Binding ResetProfileCommand}"
                            Content="{Binding ResetProfileButtonLabel}" />
                    <Button Classes="primary" Margin="0,0,0,4"
                            Command="{Binding SaveProfileCommand}"
                            Content="{Binding SaveProfileButtonLabel}" />
                  </WrapPanel>
                </Grid>

                <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="{Binding ProfileComboLabel}" Classes="sectionLabel" />
                    <TextBlock Text="{Binding SelectedProfileSummary}" FontSize="12"
                               Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" VerticalAlignment="Top"
                            ItemsSource="{Binding AvailableProfiles}"
                            SelectedItem="{Binding SelectedProfileOption}"
                            ItemTemplate="{StaticResource ProfileOptionTemplate}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="{Binding ProfileNameLabel}"
                             Classes="sectionLabel" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding ProfileName}"
                           PlaceholderText="{Binding ProfileNameWatermark}" />
                  <Button Grid.Column="2" Classes="ghost"
                          Command="{Binding RenameProfileCommand}"
                          Content="{Binding RenameProfileButtonLabel}" />
                </Grid>

              </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <!-- Was a hard 440. A fixed pane cannot give any width
                     back when the window approaches its minimum, which
                     left the rule editor to the right of it clipped
                     rather than merely narrow. Star sizing with a floor
                     keeps the overview readable while letting the
                     editor claim the surplus on a wide screen.

                     The 654 floor is what MappingEditorView needs for
                     its own two panes; see the sizing note on the
                     Window element. -->
                <ColumnDefinition Width="0.85*" MinWidth="320" />
                <ColumnDefinition Width="1.6*" MinWidth="654" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Classes="panel" Padding="18,16">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="{Binding MappingOverviewLabel}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="{Binding MappingOverviewSubtitle}"
                               FontSize="12" Foreground="{DynamicResource AppForegroundDim}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{Binding NoMappingCardsText}"
                                 Classes="hint"
                                 IsVisible="{Binding HasNoControlConfigurationCards}" />
                      <ItemsControl ItemsSource="{Binding ControlConfigurationCards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="inset" Padding="14,12" Margin="0,0,0,10">
                              <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                  <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppForeground}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               Foreground="{DynamicResource AppForegroundDim}"
                                               TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                                    <Border Classes="chip">
                                      <TextBlock Text="{Binding RuleCountText}" FontSize="10"
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource AppAccent}" />
                                    </Border>
                                    <Button Classes="ghost" Padding="10,6"
                                            Command="{Binding $parent[ItemsControl].DataContext.OpenControlEditorCommand}"
                                            CommandParameter="{Binding SelectionKey}"
                                            Content="{Binding $parent[ItemsControl].DataContext.OpenControlEditorButtonLabel}" />
                                  </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,6"
                                              Background="{DynamicResource AppSurface1}"
                                              BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1">
                                        <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="10">
                                          <Border Grid.Column="0" Width="4" CornerRadius="999"
                                                  Background="{Binding AccentColor}" />
                                          <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                     FontSize="10.5" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource AppForeground}"
                                                     VerticalAlignment="Center" />
                                          <!-- MaxLines + ellipsis, not MaxHeight:
                                               a height cap crops the third line
                                               through the middle of the glyphs,
                                               which reads as a rendering fault
                                               rather than as truncation. -->
                                          <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                     FontSize="11.5"
                                                     Foreground="{DynamicResource AppForeground}"
                                                     TextWrapping="Wrap" MaxLines="2"
                                                     TextTrimming="CharacterEllipsis"
                                                     ToolTip.Tip="{Binding Value}" />
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>

              <views:MappingEditorView Grid.Column="1"
                                       DataContext="{Binding MappingEditor}" />
            </Grid>
          </Grid>
        </TabItem>

        <!-- ═══ DEVICES ════════════════════════════════════════════════ -->
        <TabItem IsSelected="{Binding DevicesPanel.IsViewActive, Mode=OneWayToSource}">

          <TabControl Margin="8,4"
                      SelectedIndex="{Binding DevicesSubTabIndex, Mode=TwoWay}">
            <TabControl.Styles>
              <Style Selector="TabItem">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinHeight" Value="38" />
              </Style>
            </TabControl.Styles>
            <TabItem Header="{Binding DevicesPhysicalTabHeader}">

          <Grid Margin="20,16" DataContext="{Binding DevicesPanel}"
                RowDefinitions="Auto,*" RowSpacing="14">

            <!-- Header: title + refresh + counts.
                 A Grid, not a horizontal StackPanel. The provider status
                 is an arbitrary-length backend message ("SDL3: 2 gamepads,
                 1 joystick; Raw Input: keyboard+mouse") and it carried
                 TextWrapping="Wrap" — which does nothing inside a
                 horizontal StackPanel, because that panel measures its
                 children with infinite width. The text simply ran past
                 the page edge. A star column gives it a real width to
                 wrap or ellipsize against. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="16">
              <TextBlock Grid.Column="0" Text="{Binding TitleLabel}"
                         FontSize="18" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Padding="12,6"
                      Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"
                      VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                          VerticalAlignment="Center">
                <StackPanel.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource AppForegroundDim}" />
                  </Style>
                </StackPanel.Styles>
                <TextBlock Text="{Binding OnlineCount}" />
                <TextBlock Text="{Binding OnlineTotalLabel}" />
                <TextBlock Text="{Binding TotalCount}" />
                <TextBlock Text="{Binding TotalLabel}" />
              </StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding ProviderStatus}"
                         Foreground="{DynamicResource AppForegroundDim}"
                         VerticalAlignment="Center" FontSize="12"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ProviderStatus}" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="300" />
                <ColumnDefinition Width="*" MinWidth="380" />
              </Grid.ColumnDefinitions>

              <!-- Device list -->
              <Border Grid.Column="0" Classes="card" Width="340" Padding="6">
                <Panel>
                  <TextBlock Text="{Binding EmptyListLabel}"
                             Foreground="{DynamicResource AppForegroundDim}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"
                             IsVisible="{Binding IsEmpty}" />
                  <ListBox ItemsSource="{Binding Devices}"
                           SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                          <Ellipse Grid.Column="0" Width="8" Height="8"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Fill="{Binding ConnectionBrush}" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       FontSize="13" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                      Background="{Binding KindBrush}">
                                <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                           FontWeight="SemiBold" Foreground="White" />
                              </Border>
                              <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.5"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding HasHardwareId}">
                                <TextBlock Text="{Binding VendorIdHex}" FontSize="11" />
                                <TextBlock Text=":" FontSize="11" />
                                <TextBlock Text="{Binding ProductIdHex}" FontSize="11" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ConnectionText}" FontSize="10"
                                       Foreground="{DynamicResource AppForegroundDim}"
                                       HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" Spacing="3"
                                        IsVisible="{Binding HasBattery}"
                                        HorizontalAlignment="Right">
                              <TextBlock Text="{Binding BatteryIcon}" FontSize="9"
                                         Foreground="{DynamicResource AppSuccess}" />
                              <TextBlock Text="{Binding BatteryText}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AppSuccess}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
              </Border>

              <!-- Detail pane -->
              <Border Grid.Column="1" Classes="card" Padding="16,14">
                <Panel>
                  <TextBlock Text="{Binding NoSelectionLabel}"
                             Foreground="{DynamicResource AppForegroundDim}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                             IsVisible="{Binding !HasSelectedDevice}" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                IsVisible="{Binding HasSelectedDevice}">
                    <StackPanel Spacing="14">
                    <StackPanel Spacing="10" DataContext="{Binding SelectedDevice}">
                      <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center" />
                        <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                Background="{Binding KindBrush}">
                          <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                     FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border Classes="chip" Padding="7,2" IsVisible="{Binding HasBattery}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding BatteryIcon}" FontSize="10"
                                       Foreground="{DynamicResource AppSuccess}" />
                            <TextBlock Text="{Binding BatteryStatusText}" FontSize="10.5"
                                       Foreground="{DynamicResource AppSuccess}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <Border Classes="divider" />

                      <StackPanel Spacing="3" IsVisible="{Binding HasHardwareId}">
                        <TextBlock Text="VID : PID" Classes="sectionLabel" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding VendorIdHex}" FontFamily="Consolas" FontSize="12" />
                          <TextBlock Text=":" FontSize="12" Opacity="0.5" />
                          <TextBlock Text="{Binding ProductIdHex}" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Text="DEVICE ID" Classes="sectionLabel" />
                        <TextBlock Text="{Binding Id}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Spacing="3" IsVisible="{Binding HasHardwareId}">
                        <TextBlock Text="HARDWARE ID" Classes="sectionLabel" />
                        <TextBlock Text="{Binding HardwareId}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>

                    <!-- Category override (DevicesPanel scope) — the "use
                         this HID device as a gamepad" escape hatch for
                         devices Windows/SDL misidentifies. Applied in the
                         device catalog itself, so slots, themes, and the
                         dashboard all see the corrected type. -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasCategoryOverrideTarget}">
                      <Border Classes="divider" />
                      <TextBlock Text="TREAT AS" Classes="sectionLabel" />
                      <TextBlock Classes="hint"
                                 Text="If Windows identifies this device incorrectly (e.g. a HID controller listed as unknown, or a device stuck as keyboard/mouse), override its type here. Takes effect immediately and persists." />
                      <ComboBox ItemsSource="{Binding CategoryOverrideOptions}"
                                SelectedItem="{Binding SelectedCategoryOverride, Mode=TwoWay}"
                                MinHeight="28" FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>

                    <!-- Button calibration (DevicesPanel scope) — gamepad/joystick only -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsCalibratableSelected}">
                      <Border Classes="divider" />
                      <TextBlock Text="BUTTON MAPPING" Classes="sectionLabel" />
                      <TextBlock Classes="hint"
                                 Text="If this controller's buttons are recognized in the wrong places, calibrate it — you'll be prompted to press each button in turn." />
                      <StackPanel Orientation="Horizontal" Spacing="8"
                                  IsVisible="{Binding !IsCalibrating}">
                        <Button Content="Calibrate buttons" Command="{Binding StartCalibrationCommand}" />
                        <Button Content="Clear mapping" Command="{Binding ClearButtonMapCommand}"
                                IsVisible="{Binding HasButtonMap}" />
                        <TextBlock Text="✓ mapped" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AppAccent}"
                                   IsVisible="{Binding HasButtonMap}" />
                      </StackPanel>
                      <Border IsVisible="{Binding IsCalibrating}"
                              BorderBrush="{DynamicResource AppAccent}" BorderThickness="1"
                              CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding CalibrationPrompt}" FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="Press that button on the controller, or Skip to leave it unmapped."
                                     Classes="fieldLabel" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Skip" Command="{Binding SkipButtonCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelCalibrationCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Keyboard-as-gamepad reference (DevicesPanel scope) — keyboard only -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsKeyboardSelected}">
                      <Border Classes="divider" />
                      <TextBlock Text="KEYBOARD AS GAMEPAD" Classes="sectionLabel" />
                      <TextBlock Classes="hint" Text="{Binding KeyboardHintLabel}" />
                      <!--
                          Fixed-height live readout. The key list changes on
                          every keystroke, and while it was free to wrap it
                          grew and shrank a line at a time, walking the
                          keyboard diagram below it up and down the page as
                          you typed. Two lines' worth of reserved space fits
                          any realistic chord.
                      -->
                      <Border Classes="inset" Padding="8" Margin="0,2">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding KeysDownLabel}" Classes="sectionLabel" />
                          <TextBlock Text="{Binding KeyboardKeysDown}" Classes="mono"
                                     Height="34" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <views:KeyboardSurface />
                      </Viewbox>
                    </StackPanel>

                    <!-- Mouse-as-gamepad (DevicesPanel scope) — mouse only -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsMouseSelected}">
                      <Border Classes="divider" />
                      <TextBlock Text="MOUSE AS GAMEPAD" Classes="sectionLabel" />
                      <TextBlock Classes="hint" Text="{Binding MouseHintLabel}" />
                      <!-- Reserved height, same reasoning as the keyboard
                           readout above: this updates continuously as the
                           pointer moves. -->
                      <Border Classes="inset" Padding="8" Margin="0,2">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding InputLiveLabel}" Classes="sectionLabel" />
                          <TextBlock Text="{Binding MouseInfo}" Classes="mono"
                                     Height="34" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <views:MouseSurface />
                    </StackPanel>

                    <!-- Live raw state (DevicesPanel scope) -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasRawState}">
                      <Border Classes="divider" />
                      <TextBlock Text="LIVE STATE" Classes="sectionLabel" />

                      <!-- Axes -->
                      <ItemsControl ItemsSource="{Binding RawAxes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="46,*,52" Margin="0,2">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="fieldLabel"
                                         VerticalAlignment="Center" />
                              <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                                           Value="{Binding Normalized}" Height="6"
                                           VerticalAlignment="Center" Margin="4,0" />
                              <TextBlock Grid.Column="2" Text="{Binding RawText}" Classes="mono" FontSize="10"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Buttons -->
                      <ItemsControl ItemsSource="{Binding RawButtons}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="26" Height="22" Margin="2" CornerRadius="5"
                                    Background="{Binding StateBrush}">
                              <TextBlock Text="{Binding Label}" FontSize="10"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Hats -->
                      <ItemsControl ItemsSource="{Binding RawHats}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="46,*" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                         Opacity="0.7" />
                              <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="11"
                                         FontFamily="Consolas" Opacity="0.85" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Panel>
              </Border>
            </Grid>
          </Grid>
            </TabItem>

            <TabItem Header="{Binding DevicesVirtualTabHeader}">

          <Grid x:Name="SlotsRoot" Margin="20,16" DataContext="{Binding SlotsPanel}"
                RowDefinitions="Auto,*" RowSpacing="14">

            <!-- Create controls -->
            <StackPanel Grid.Row="0" Spacing="10">
              <TextBlock Text="{Binding VirtualControllersHeader}" Classes="sectionLabel" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox MinWidth="180" ItemsSource="{Binding OutputKindOptions}"
                          SelectedItem="{Binding NewSlotKind}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{Binding AddControllerLabel}" Command="{Binding CreateSlotCommand}" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="14" RowDefinitions="Auto,*" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="260" />
                <ColumnDefinition Width="*" MinWidth="420" />
              </Grid.ColumnDefinitions>

              <!-- Master: slot list -->
              <Border Grid.Column="0" Grid.RowSpan="2" Classes="card" Width="320" Padding="6">
                <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2,4">
                        <Panel Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                          <Ellipse Width="9" Height="9"
                                    Fill="{DynamicResource AppSuccess}"
                                   IsVisible="{Binding Enabled}" />
                          <Ellipse Width="9" Height="9"
                                   Fill="{DynamicResource AppForegroundDim}"
                                   IsVisible="{Binding !Enabled}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="fieldLabel" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding KindLabel}" />
                            <Run Text=" · " />
                            <Run Text="{Binding DeviceSummary}" />
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <!-- Selected-slot context stays visible while switching
                   feature tabs, matching the output/device hierarchy in
                   PadForge without hiding identity inside the first tab. -->
              <Border Grid.Column="1" Grid.Row="0" Classes="card" Padding="14,11"
                      IsVisible="{Binding HasSelectedSlot}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                          Background="{DynamicResource AppAccentSoft}">
                    <TextBlock Text="{Binding SelectedSlot.OutputIcon}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AppAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding SelectedSlotLabel}" Classes="sectionLabel"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SlotName}" FontSize="15" FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource AppForegroundDim}"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding SelectedSlotOutput}" />
                      <Run Text="  ·  " />
                      <Run Text="{Binding SelectedSlotInput}" />
                      <Run Text="  ·  " />
                      <Run Text="{Binding SelectedSlotProfiles}" />
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" CornerRadius="12" MinWidth="64" Height="26" Padding="9,0"
                          BorderBrush="{Binding SelectedSlotStatusBrush}" BorderThickness="1"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSlotStatus}"
                               Foreground="{Binding SelectedSlotStatusBrush}"
                               FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>

              <!-- Empty state, matching the Devices detail pane and the
                   mapping-rule editor. Without it this half of the page
                   is simply blank until a slot is picked. -->
              <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding NoSlotSelectedLabel}"
                         Foreground="{DynamicResource AppForegroundDim}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                         IsVisible="{Binding !HasSelectedSlot}" />

              <!-- Detail. Tabbed rather than one long scroll: the
                   Touchpad tab only exists for slots whose hardware has a
                   touch surface, and a section that silently appears and
                   disappears part-way down a scroll reads as a glitch. -->
              <TabControl Grid.Column="1" Grid.Row="1" IsVisible="{Binding HasSelectedSlot}"
                          ClipToBounds="True">
                <TabItem Header="{Binding PreviewTabHeader}">
                  <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                      <Border Classes="card" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Map the controller you see" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="hint"
                                       Text="Hover a virtual button, trigger, touchpad, or stick to identify it. Click it to choose that output and create its mapping rule." />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost" Content="Open all mappings"
                                  Command="{Binding #ShellRoot.DataContext.OpenMappingsCommand}"
                                  VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <Border Classes="panel" Padding="10" MinHeight="330" ClipToBounds="True">
                        <views:ControllerSurface DataContext="{Binding #ShellRoot.DataContext.SlotConfigurationController}" />
                      </Border>

                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="inset" Padding="12">
                          <StackPanel Spacing="3">
                            <TextBlock Text="1  CHOOSE OUTPUT" Classes="sectionLabel" />
                            <TextBlock Text="Click it on the controller" Classes="hint" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="inset" Padding="12">
                          <StackPanel Spacing="3">
                            <TextBlock Text="2  CHOOSE INPUT" Classes="sectionLabel" />
                            <TextBlock Text="Pick the physical source" Classes="hint" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="inset" Padding="12">
                          <StackPanel Spacing="3">
                            <TextBlock Text="3  SAVE RULE" Classes="sectionLabel" />
                            <TextBlock Text="The slot updates immediately" Classes="hint" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding SlotSettingsTabHeader}">
                <ScrollViewer>
                <StackPanel Spacing="14" Margin="0,10,0,0">

                  <!-- Identity + lifecycle -->
                  <StackPanel Spacing="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Name" Classes="fieldLabel" />
                      <TextBox Text="{Binding SlotName}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <CheckBox Grid.Column="0" Content="{Binding SlotEnabledLabel}" IsChecked="{Binding SlotEnabled}" />
                      <Button Grid.Column="1" Classes="ghost" Content="{Binding SlotDuplicateLabel}" Command="{Binding DuplicateSlotCommand}" />
                      <Button Grid.Column="2" Classes="primary" Content="{Binding SlotSaveLabel}" Command="{Binding SaveSlotCommand}" />
                      <Button Grid.Column="3" Classes="danger" Content="{Binding SlotDeleteLabel}" Command="{Binding DeleteSlotCommand}" />
                    </Grid>
                  </StackPanel>

                  <Border Classes="divider" />

                  <!-- Device assignment -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="ASSIGNED DEVICES" Classes="sectionLabel" />
                    <ItemsControl ItemsSource="{Binding AssignedDevices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Classes="danger" Content="Remove" FontSize="11"
                                    Command="{Binding #SlotsRoot.DataContext.UnassignDeviceCommand}"
                                    CommandParameter="{Binding Id}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Demo preview: drives this virtual controller with
                         the built-in animated waveform instead of its
                         assigned devices — end-to-end (dashboard AND the
                         real HIDMaestro output), no physical pad needed.
                         While it's on, assigning devices is moot, so the
                         Available list below is disabled. -->
                    <CheckBox Content="{Binding TemplateEditor.DemoPreviewLabel}"
                              IsChecked="{Binding TemplateEditor.DemoPreview}"
                              ToolTip.Tip="{Binding TemplateEditor.DemoPreviewTooltip}"
                              Margin="0,4,0,0" FontSize="12" />

                    <StackPanel Spacing="6" IsEnabled="{Binding !TemplateEditor.DemoPreview}">
                    <TextBlock Text="Available" Classes="fieldLabel" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding AvailableDevices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Add" FontSize="11"
                                    Command="{Binding #SlotsRoot.DataContext.AssignDeviceCommand}"
                                    CommandParameter="{Binding Id}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <Border Classes="divider" />

                  <!-- Layered profiles (SlotsPanel scope) -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="PROFILES (LAYERED)" Classes="sectionLabel" />
                    <TextBlock Text="Applied in order; later layers win. Empty = pass-through."
                               Classes="hint" />
                    <ItemsControl ItemsSource="{Binding AssignedProfiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="≡" Opacity="0.4"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Classes="danger" Content="Remove" FontSize="11"
                                    Command="{Binding #SlotsRoot.DataContext.RemoveProfileCommand}"
                                    CommandParameter="{Binding Id}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding AvailableProfiles}"
                                SelectedItem="{Binding SelectedAvailableProfile}"
                                PlaceholderText="Add a profile layer…">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" Content="Add" FontSize="11" Margin="8,0,0,0"
                              Command="{Binding #SlotsRoot.DataContext.AddProfileCommand}" />
                    </Grid>
                  </StackPanel>

                  <Border Classes="divider" />

                  <!-- Output template (bound to SlotsPanel.TemplateEditor) -->
                  <StackPanel Spacing="10" DataContext="{Binding TemplateEditor}"
                              IsVisible="{Binding HasTemplate}">
                    <TextBlock Text="OUTPUT TEMPLATE" Classes="sectionLabel" />
                    <CheckBox Content="{Binding EmitLabel}"
                              ToolTip.Tip="{Binding EmitTooltip}"
                              IsChecked="{Binding Enabled}" />
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding OutputDeviceLabel}" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding OutputKindOptions}"
                                SelectedItem="{Binding SelectedOutputKind}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <!-- Output backend is implicit now: HIDMaestro is the
                         sole Windows output backend, so there's nothing to
                         pick — the old provider combo box was one item of
                         dead choice. -->

                    <!-- Full HIDMaestro catalog (225 profiles) — lets this
                         slot emit ANY supported controller, not just the
                         four curated kinds above. Hidden until the catalog
                         has been enumerated. -->
                    <StackPanel Spacing="3" IsVisible="{Binding HasOutputProfileOptions}">
                      <TextBlock Text="{Binding OutputProfileLabel}" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding OutputProfileOptions}"
                                SelectedItem="{Binding SelectedOutputProfile}"
                                ToolTip.Tip="{Binding OutputProfileTooltip}"
                                MaxDropDownHeight="420"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding ShowGenericShape}">
                      <TextBlock Text="Device shape" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Thumbsticks" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding ThumbstickCount}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Triggers" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding TriggerCount}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Buttons" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding ButtonCount}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="POVs" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding PovCount}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Product name" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding ProductString}" PlaceholderText="GameFlow Game Controller" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Vendor ID (hex)" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding GenericVidText}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Product ID (hex)" FontSize="11" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="6" Grid.Column="1" Text="{Binding GenericPidText}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding MappingsTabHeader}">
                  <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                      <Border Classes="card" Padding="16">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Mappings" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Classes="hint"
                                     Text="For the fastest setup, return to Preview and click the exact virtual control you want to produce. The focused editor will ask for its physical source." />
                          <Button Content="Open complete mapping rule editor"
                                  Command="{Binding #ShellRoot.DataContext.OpenMappingsCommand}"
                                  HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>

                      <Border Classes="card" Padding="16">
                        <StackPanel Spacing="8">
                          <TextBlock Text="PROFILE LAYERS" Classes="sectionLabel" />
                          <TextBlock Text="No profile layers · direct pass-through is active"
                                     Classes="hint" IsVisible="{Binding !AssignedProfiles.Count}" />
                          <ItemsControl ItemsSource="{Binding AssignedProfiles}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="inset" Padding="10" Margin="0,0,0,6">
                                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="●" FontSize="8"
                                               Foreground="{DynamicResource AppSuccess}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="hint"
                                     Text="Add, remove, and reorder profile layers from Setup. Later layers take priority." />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <!-- Touchpad. Hidden unless an assigned device actually
                     reports a touch surface (DualSense / DualSense Edge /
                     DualShock 4), so it never shows a page of controls
                     that could not do anything. -->
                <TabItem Header="{Binding TouchpadTabHeader}"
                         IsVisible="{Binding SelectedSlotHasTouchpad}">
                  <ScrollViewer DataContext="{Binding TouchpadEditor}">
                    <StackPanel Spacing="14" Margin="0,10,0,0" IsVisible="{Binding HasSlot}">

                      <!-- Joystick -->
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding JoystickSectionLabel}" Classes="sectionLabel" />
                        <CheckBox Content="{Binding StickEnabledLabel}" IsChecked="{Binding StickEnabled}" />
                        <TextBlock Text="{Binding JoystickHint}" Classes="hint" />
                        <StackPanel Spacing="6" IsEnabled="{Binding StickEnabled}" Margin="0,4,0,0">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding TargetStickLabel}" Classes="fieldLabel" />
                            <ComboBox ItemsSource="{Binding StickOptions}" SelectedItem="{Binding TargetStick}"
                                      HorizontalAlignment="Stretch" />
                          </StackPanel>
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding StickSensitivityLabel}" Classes="fieldLabel" />
                            <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                              <Slider Grid.Column="0" Minimum="0.1" Maximum="10" SmallChange="0.1"
                                      LargeChange="0.5" Value="{Binding StickSensitivity}" />
                              <TextBox Grid.Column="1" Text="{Binding StickSensitivity}"
                                       HorizontalContentAlignment="Center" />
                            </Grid>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <Border Classes="divider" />

                      <!-- D-pad -->
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DpadSectionLabel}" Classes="sectionLabel" />
                        <CheckBox Content="{Binding DpadEnabledLabel}" IsChecked="{Binding DpadEnabled}" />
                        <StackPanel Spacing="6" IsEnabled="{Binding DpadEnabled}" Margin="0,4,0,0">
                          <CheckBox Content="{Binding DpadEightWayLabel}" IsChecked="{Binding DpadEightWay}" />
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding DpadDeadzoneLabel}" Classes="fieldLabel" />
                            <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                              <Slider Grid.Column="0" Minimum="0" Maximum="0.5" SmallChange="0.01"
                                      LargeChange="0.05" Value="{Binding DpadDeadzoneRadius}" />
                              <TextBox Grid.Column="1" Text="{Binding DpadDeadzoneRadius}"
                                       HorizontalContentAlignment="Center" />
                            </Grid>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <Border Classes="divider" />

                      <!-- Mouse -->
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding MouseSectionLabel}" Classes="sectionLabel" />
                        <CheckBox Content="{Binding MouseEnabledLabel}" IsChecked="{Binding MouseEnabled}" />
                        <TextBlock Text="{Binding MouseHint}" Classes="hint" />
                        <StackPanel Spacing="6" IsEnabled="{Binding MouseEnabled}" Margin="0,4,0,0">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding MouseSensitivityXLabel}" Classes="fieldLabel" />
                            <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                              <Slider Grid.Column="0" Minimum="0.1" Maximum="10" SmallChange="0.1"
                                      LargeChange="0.5" Value="{Binding MouseSensitivityX}" />
                              <TextBox Grid.Column="1" Text="{Binding MouseSensitivityX}"
                                       HorizontalContentAlignment="Center" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding MouseSensitivityYLabel}" Classes="fieldLabel" />
                            <Grid ColumnDefinitions="*,88" ColumnSpacing="10">
                              <Slider Grid.Column="0" Minimum="0.1" Maximum="10" SmallChange="0.1"
                                      LargeChange="0.5" Value="{Binding MouseSensitivityY}" />
                              <TextBox Grid.Column="1" Text="{Binding MouseSensitivityY}"
                                       HorizontalContentAlignment="Center" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="{Binding InvertMouseXLabel}" IsChecked="{Binding InvertMouseX}" />
                            <CheckBox Content="{Binding InvertMouseYLabel}" IsChecked="{Binding InvertMouseY}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <Border Classes="divider" />

                      <!-- Gestures -->
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding GesturesSectionLabel}" Classes="sectionLabel" />
                        <CheckBox Content="{Binding GesturesEnabledLabel}" IsChecked="{Binding GesturesEnabled}" />

                        <StackPanel Spacing="8" IsEnabled="{Binding GesturesEnabled}" Margin="0,4,0,0">
                          <TextBlock Text="{Binding NoGesturesLabel}" Classes="hint"
                                     IsVisible="{Binding !HasGestures}" />

                          <ItemsControl ItemsSource="{Binding Gestures}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border CornerRadius="6" BorderThickness="1" Padding="10" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource AppBorder0}">
                                  <StackPanel Spacing="8">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                      <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                VerticalAlignment="Center" />
                                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding Parent.KindOptions}"
                                                SelectedItem="{Binding Kind}" />
                                      <Button Grid.Column="2" Classes="danger" FontSize="11"
                                              Content="{Binding Parent.RemoveLabel}"
                                              Command="{Binding Parent.RemoveGestureCommand}"
                                              CommandParameter="{Binding Id}" />
                                    </Grid>

                                    <!-- Per-kind detail. Exactly one of these
                                         shows at a time, driven by the row's
                                         own Show* flags. -->
                                    <StackPanel Spacing="6" IsVisible="{Binding ShowSwipeDetail}">
                                      <ComboBox HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding Parent.SwipeDirectionOptions}"
                                                SelectedItem="{Binding SwipeDirection}" />
                                      <CheckBox Content="{Binding Parent.GestureEightWayLabel}"
                                                IsChecked="{Binding EightWay}" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,80" ColumnSpacing="8"
                                          IsVisible="{Binding ShowTapDetail}">
                                      <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="fieldLabel" Text="{Binding Parent.GestureTapCountLabel}" />
                                      <TextBox Grid.Column="1" Text="{Binding TapCount}"
                                               HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <ComboBox HorizontalAlignment="Stretch" IsVisible="{Binding ShowPinchDetail}"
                                              ItemsSource="{Binding Parent.PinchDirectionOptions}"
                                              SelectedItem="{Binding PinchDirection}" />

                                    <ComboBox HorizontalAlignment="Stretch" IsVisible="{Binding ShowRotateDetail}"
                                              ItemsSource="{Binding Parent.RotateDirectionOptions}"
                                              SelectedItem="{Binding RotateDirection}" />

                                    <ComboBox HorizontalAlignment="Stretch" IsVisible="{Binding ShowShapeDetail}"
                                              ItemsSource="{Binding Parent.ShapeOptions}"
                                              SelectedItem="{Binding Shape}" />

                                    <Grid ColumnDefinitions="Auto,80" ColumnSpacing="8"
                                          IsVisible="{Binding ShowFingerCount}">
                                      <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="fieldLabel" Text="{Binding Parent.GestureFingersLabel}" />
                                      <TextBox Grid.Column="1" Text="{Binding FingerCount}"
                                               HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto,80" ColumnSpacing="8">
                                      <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="fieldLabel" Text="{Binding Parent.GestureTargetLabel}" />
                                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                MaxDropDownHeight="320"
                                                ItemsSource="{Binding Parent.ButtonOptions}"
                                                SelectedItem="{Binding TargetButton}" />
                                      <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="fieldLabel" Text="{Binding Parent.GestureHoldLabel}" />
                                      <TextBox Grid.Column="3" Text="{Binding HoldMilliseconds}"
                                               HorizontalContentAlignment="Center" />
                                    </Grid>

                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Button Content="{Binding AddGestureLabel}" Command="{Binding AddGestureCommand}"
                                  HorizontalAlignment="Left" />
                        </StackPanel>
                      </StackPanel>

                      <Border Classes="divider" />

                      <!-- Recognition thresholds. These describe the
                           surface and the hand using it, so they are
                           shared by every gesture rather than set per
                           binding. -->
                      <StackPanel Spacing="6" IsEnabled="{Binding GesturesEnabled}">
                        <TextBlock Text="{Binding TuningSectionLabel}" Classes="sectionLabel" />
                        <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8" RowSpacing="5">
                          <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding SwipeMinDistanceLabel}" />
                          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SwipeMinDistance}" />
                          <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding TapMaxLabel}" />
                          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TapMaxMilliseconds}" />
                          <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding MultiTapWindowLabel}" />
                          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MultiTapWindowMilliseconds}" />
                          <TextBlock Grid.Row="3" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding LongPressLabel}" />
                          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LongPressMilliseconds}" />
                          <TextBlock Grid.Row="4" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding PinchThresholdLabel}" />
                          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PinchThreshold}" />
                          <TextBlock Grid.Row="5" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding RotateThresholdLabel}" />
                          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RotateThresholdDegrees}" />
                          <TextBlock Grid.Row="6" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding ShapeThresholdLabel}" />
                          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ShapeMatchThreshold}" />
                        </Grid>
                      </StackPanel>

                    </StackPanel>
                  </ScrollViewer>
                </TabItem>
              </TabControl>
            </Grid>
          </Grid>
            </TabItem>
          </TabControl>
        </TabItem>


      </TabControl>

    </Grid>
  </Grid>
</Window>
