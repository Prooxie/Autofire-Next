<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             x:Class="GameFlow.App.App"
             RequestedThemeVariant="Dark">

  <!-- Seed the default Cyber Blue color palette so DynamicResource bindings
       resolve immediately on first paint (before AppThemeService is called). -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- DesignTokens supplies the shared spacing, radius and typography
           scales consumed by Typography.axaml and the reusable app styles. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GameFlow.App/Themes/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="AppAccent"       Color="#00D4FF" />
      <SolidColorBrush x:Key="AppAccentSoft"   Color="#0F2530" />
      <SolidColorBrush x:Key="AppAccentHover"  Color="#22DEFF" />
      <SolidColorBrush x:Key="AppBorderActive" Color="#00D4FF" />
      <SolidColorBrush x:Key="AppSurface0"     Color="#050B12" />
      <SolidColorBrush x:Key="AppSurface1"     Color="#07101D" />
      <SolidColorBrush x:Key="AppSurface2"     Color="#0A1628" />
      <SolidColorBrush x:Key="AppBorder0"      Color="#0F2035" />
      <SolidColorBrush x:Key="AppBorder1"      Color="#1E3A5A" />
      <SolidColorBrush x:Key="AppForeground"   Color="#E2E8F0" />
      <SolidColorBrush x:Key="AppForegroundDim" Color="#7D8BA3" />
      <SolidColorBrush x:Key="AppPrimaryBtn"   Color="#040C16" />
      <SolidColorBrush x:Key="AppBadgeForeground" Color="#040C16" />

      <!-- Theme-aware semantic roles. AppThemeService swaps these alongside
           the selected palette so status and destructive-action colors keep
           their contrast in both dark and light themes. -->
      <SolidColorBrush x:Key="AppSuccess"       Color="#34D399" />
      <SolidColorBrush x:Key="AppSuccessSoft"   Color="#0C2A21" />
      <SolidColorBrush x:Key="AppWarning"       Color="#FBBF24" />
      <SolidColorBrush x:Key="AppWarningSoft"   Color="#33250A" />
      <SolidColorBrush x:Key="AppDanger"        Color="#FB7185" />
      <SolidColorBrush x:Key="AppDangerSoft"    Color="#35121A" />
      <SolidColorBrush x:Key="AppInfo"          Color="#60A5FA" />
      <SolidColorBrush x:Key="AppInfoSoft"      Color="#102440" />
      <SolidColorBrush x:Key="AppFeature"       Color="#C4B5FD" />
      <SolidColorBrush x:Key="AppFeatureSoft"   Color="#25193D" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <themes:FluentTheme />
    <StyleInclude Source="avares://GameFlow.App/Assets/Styles/AppTheme.axaml" />
    <StyleInclude Source="avares://GameFlow.App/Themes/Typography.axaml" />
  </Application.Styles>
</Application>
